#: src/libs/resume/ats.ts
msgid "This entry is an image with no text behind it."
msgstr "這段內容只有圖片,沒有可讀取的文字。"

#: src/libs/resume/ats.ts
msgid "Write the content as text. A photo is fine; a picture standing in for the words is not."
msgstr "把內容寫成文字。證件照沒問題,但用圖片代替文字不行。"

#: src/libs/resume/ats.ts
msgid "This contact field is an icon with no text."
msgstr "這個聯絡方式只有圖示,沒有文字。"

#: src/libs/resume/ats.ts
msgid "Add the text next to the icon. Parsers drop the icon and keep the text."
msgstr "在圖示旁邊補上文字。解析時會丟掉圖示、只留下文字。"

#: src/libs/resume/ats.ts
msgid "This period has a start but no end."
msgstr "這段時間只有開始,沒有結束。"

#: src/libs/resume/ats.ts
msgid "Add an end date, or write 至今 for a role you still hold."
msgstr "補上結束時間;如果仍在職,就寫「至今」。"

#: src/libs/resume/ats.ts
msgid "This role has no job title."
msgstr "這段經歷沒有職稱。"

#: src/libs/resume/ats.ts
msgid "Domestic parsers find a role by its company, title and dates. Fill in the title, or give each nested role one."
msgstr "國內系統按「公司 - 職稱 - 起止時間」識別經歷。填上職稱,或給每個子職位各填一個。"

#: src/libs/resume/ats.ts
msgid "Some characters here come from an icon font."
msgstr "這裡有字元來自圖示字型。"

#: src/libs/resume/ats.ts
msgid "Replace them with plain text or ordinary punctuation. Outside this file they carry no meaning."
msgstr "換成一般文字或常規標點。離開這份檔案,這些字元沒有任何意義。"

#: src/libs/resume/ats.ts
msgid "This date is typed with fullwidth digits."
msgstr "這個日期用了全形數字。"

#: src/libs/resume/ats.ts
msgid "Retype it with halfwidth digits, as in 2020-03."
msgstr "改成半形數字,例如 2020-03。"

#: src/libs/resume/ats.ts
msgid "These bullets are drawn with decorative characters."
msgstr "這些項目符號用的是裝飾性字元。"

#: src/libs/resume/ats.ts
msgid "Use the editor's bullet list, or a plain -, * or •."
msgstr "用編輯器的項目符號清單,或改用 -、*、• 這類常規符號。"

#: src/features/auth/pages/reset-password.tsx
msgid "Your password has been reset. You can now sign in with your new password."
msgstr "您的密碼已重設。現在可以用新密碼登入了。"

#: src/dialogs/auth/change-password.tsx
msgid "Your password has been updated."
msgstr "您的密碼已更新。"

#: src/features/settings/authentication/components/phone-section.tsx
msgid "Your phone number has been changed."
msgstr "你的手機號碼已更換。"

#: src/features/ats-checker/messages.ts
msgid "Your phone number is written in an unusual shape."
msgstr "您的電話號碼寫法不太常見。"

#: src/features/settings/pages/profile.tsx
msgid "Your profile has been updated."
msgstr "您的個人資料已更新。"

#: src/dialogs/resume/index.tsx
msgid "Your resume has been created."
msgstr "已建立您的履歷。"

#: src/routes/builder/$resumeId/-components/header.tsx
#: src/routes/dashboard/resumes/-components/menus/use-resume-menu-actions.ts
msgid "Your resume has been deleted."
msgstr "已刪除您的履歷。"

#: src/dialogs/resume/index.tsx
msgid "Your resume has been duplicated."
msgstr "已複製您的履歷。"

#: src/dialogs/resume/import.tsx
msgid "Your resume has been imported."
msgstr "已匯入您的履歷。"

#: src/routes/builder/$resumeId/-components/version-history.tsx
msgid "Your resume has been restored to the selected version."
msgstr "您的履歷已恢復為所選版本。"

#: src/dialogs/resume/index.tsx
msgid "Your resume has been updated."
msgstr "已更新您的履歷。"

#: src/libs/resume/ats.ts
msgid "Your resume has no email address."
msgstr "你的履歷沒有電子郵件地址。"

#: src/libs/resume/ats.ts
msgid "Your resume has no location."
msgstr "你的履歷沒有位置。"

#: src/libs/resume/ats.ts
msgid "Your resume has no name."
msgstr "你的履歷沒有姓名。"

#: src/libs/resume/ats.ts
msgid "Your resume has no phone number."
msgstr "你的履歷上沒有電話號碼。"

#: src/libs/resume/ats.ts
msgid "Your resume includes a photo."
msgstr "你的履歷裡有一張照片。"

#: src/features/homepage/feature-explorer.tsx
msgid "Your resume link"
msgstr "你的履歷連結"

#: src/libs/resume/ats.ts
msgid "Your resume shows no work experience."
msgstr "你的履歷沒有顯示任何工作經驗。"

#: src/features/ats-checker/messages.ts
msgid "Your resume uses \"I\" and \"my\"."
msgstr "您的履歷使用了「我」和「我的」這類詞。"

#: src/routes/builder/$resumeId/-sidebar/right/sections/sharing.tsx
msgid "Your resume's public URL is protected by a password. Share the password only with people you trust."
msgstr "您履歷的公開 URL 受密碼保護。請只把密碼分享給您信任的人。"

#: src/features/homepage/ats-playground.tsx
msgid "Your selected file"
msgstr "你選擇的檔案"

#: src/features/homepage/export-playground.tsx
msgid "Your words as a plain-text document, with headings, lists, and links."
msgstr "把你的文字變成純文字文件，含標題、清單與連結。"

